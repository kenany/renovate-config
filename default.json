{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableDependencyDashboard",
    ":maintainLockFilesWeekly",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    ":label(deps)",
    ":rebaseStalePrs",
    "customManagers:tsconfigNodeVersions",
    "docker:enableMajor",
    "docker:pinDigests"
  ],
  "configMigration": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "minimumReleaseAge": null
  },
  "minimumReleaseAge": "7 days",
  "postUpdateOptions": ["pnpmDedupe", "yarnDedupeHighest"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "extends": [
        ":automergeMinor",
        ":automergePr",
        ":automergeRequireAllStatusChecks",
        ":semanticCommitScope(ci)",
        ":label(ci)"
      ]
    },
    {
      "matchDatasources": ["npm"],
      "commitMessageAction": null,
      "commitMessageExtra": null,
      "commitMessageTopic": "{{depName}}@{{{newVersion}}}"
    },
    {
      "description": "Disable major eslint and eslint-config updates since they almost always require manual intervention.",
      "matchPackageNames": ["eslint", "@kenan/eslint-config"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Hold conventional-changelog-conventionalcommits at v9.",
      "matchPackageNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "<10.0.0"
    },
    {
      "description": "Automerge some minor updates.",
      "matchPackageNames": [
        "@biomejs/biome",
        "@containerbase/semantic-release-pnpm",
        "@kenan/biome-config",
        "@kenan/eslint-config",
        "conventional-changelog-conventionalcommits",
        "publint",
        "semantic-release",
        "tape",
        "tsdown"
      ],
      "extends": [
        ":automergeMinor",
        ":automergePr",
        ":automergeRequireAllStatusChecks"
      ]
    },
    {
      "description": "Separate multiple major for Node.js.",
      "matchDepNames": ["node", "**/node"],
      "separateMultipleMajor": true
    },
    {
      "description": "Set branch prefix for Node.js major updates to split from minor updates.",
      "matchPackageNames": ["node", "**/node"],
      "matchUpdateTypes": ["major"],
      "additionalBranchPrefix": "major"
    },
    {
      "description": "Split Node.js types to separate PR.",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "additionalBranchPrefix": "major-types"
    },
    {
      "description": "Widen Node.js engines.",
      "matchPackageNames": ["node"],
      "matchDepTypes": ["engines"],
      "rangeStrategy": "widen"
    }
  ]
}
